<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Linux_Mint.MVVM.View.MainPage.FlyoutContentNewPostView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="New Post"
    BackgroundColor="#D6F7E2">

    <VerticalStackLayout Padding="20,40,20,0" Spacing="20">
        <!--  Header  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Margin="0,0,0,0"
                Padding="20,5"
                BackgroundColor="#46B47F"
                CornerRadius="5"
                FontSize="16"
                HorizontalOptions="End"
                Text="Post"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <!--  Divider  -->
        <BoxView BackgroundColor="#A0C4B0" HeightRequest="1" />

        <!--  User Info Card  -->
        <Frame
            Margin="0,0,0,0"
            Padding="10"
            BackgroundColor="#E6F9ED"
            CornerRadius="20"
            HasShadow="False">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    BackgroundColor="#46B47F"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Stroke="#46B47F"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <Image
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        Source="{Binding LoggedInUser.UserAvatar, FallbackValue='default_avatar.png'}"
                        VerticalOptions="Center"
                        WidthRequest="40"
                        ></Image>
                </Border>
                <Label
                    Grid.Column="1"
                    FontSize="18"
                    Text="Christian Quizam"
                    TextColor="Black"
                    VerticalOptions="Center" />
            </Grid>
        </Frame>

        <!--  Post Text Placeholder  -->
        <Entry
            Margin="0,0,0,0"
            FontSize="18"
            HeightRequest="100"
            Placeholder="What’s on your mind?"
            TextColor="Black"
            Text="{Binding PostTexts}"
            VerticalTextAlignment="Start" />


        <!--  Add Photo Button  -->
        <Button
            Padding="0"
            BackgroundColor="#46B47F"
            CornerRadius="10"
            FontSize="20"
            HeightRequest="50"
            HorizontalOptions="Center"
            Text="Add Photo"
            TextColor="White"
            VerticalOptions="End"
            WidthRequest="300" />

        <StackLayout Orientation="Horizontal" Spacing="10">
            <Border
                x:Name="RemovableImageBorder"
                BackgroundColor="#46B47F"
                HeightRequest="100"
                HorizontalOptions="Start"
                Stroke="#46B47F"
                StrokeThickness="0"
                WidthRequest="100">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />

                </Border.StrokeShape>
                <Grid>
                    <Image
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        Source="{Binding PostImage, FallbackValue='default_avatar.png'}"
                        VerticalOptions="Center"
                        WidthRequest="100" />
                    <Button
                        Padding="0"
                        BackgroundColor="Transparent"
                        Clicked="OnRemoveImageClicked"
                        FontSize="18"
                        HeightRequest="30"
                        HorizontalOptions="End"
                        Text="✕"
                        TextColor="White"
                        VerticalOptions="Start"
                        WidthRequest="30"/>
                </Grid>
            </Border>
        </StackLayout>

    </VerticalStackLayout>
</ContentPage>
