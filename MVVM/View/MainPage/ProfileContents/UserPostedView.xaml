<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Linux_Mint.MVVM.View.MainPage.ProfileContents.UserPostedView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="PageRoot">

    <ContentView.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="Fontello" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryDarkText}" />
        </Style>
        <Style x:Key="LabelFormat" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryDarkText}" />
        </Style>
        <Style x:Key="PostTextFormat" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="20" />
            <Setter Property="TextColor" Value="{StaticResource SecondaryDarkText}" />
        </Style>
        <Style x:Key="Post" TargetType="Border">
            <Setter Property="Stroke" Value="{StaticResource Hexa}" />
            <Setter Property="StrokeShape" Value="RoundRectangle, 30" />
            <Setter Property="BackgroundColor" Value="{StaticResource Hexa}" />
        </Style>
    </ContentView.Resources>

    <CollectionView
        BackgroundColor="Transparent"
        ItemsSource="{Binding Posts}"
        VerticalOptions="Fill">

        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="20" Style="{StaticResource Post}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  User Info + Post Text  -->
                        <Grid
                            Grid.Row="0"
                            ColumnSpacing="10"
                            RowSpacing="0"
                            VerticalOptions="Start">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height=".3*" />
                                <RowDefinition Height=".1*" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                HeightRequest="50"
                                Stroke="{StaticResource Penta}"
                                StrokeShape="RoundRectangle 100"
                                StrokeThickness="1"
                                WidthRequest="50">
                                <Frame
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="Transparent"
                                    CornerRadius="50"
                                    IsClippedToBounds="True"
                                    VerticalOptions="Center">

                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="50"
                                        HorizontalOptions="Fill"
                                        Source="{Binding UserAvatar}"
                                        VerticalOptions="Fill"
                                        WidthRequest="50" />
                                </Frame>
                            </Border>

                            <VerticalStackLayout
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalOptions="Center">
                                <Label Style="{StaticResource LabelFormat}" Text="{Binding FullName}" />
                                <Label
                                    FontSize="18"
                                    Text="{Binding TimeAgo}"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                            <!--  Edit Button  -->
                            <Button
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                BackgroundColor="Transparent"
                                Command="{Binding BindingContext.EditPostCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}"
                                Style="{StaticResource BaseButtonStyle}"
                                Text="&#xe807;"
                                VerticalOptions="Start"
                                WidthRequest="50" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">
                                <Border
                                    Grid.ColumnSpan="3"
                                    Margin="0"
                                    HeightRequest="5"
                                    Stroke="Transparent"
                                    VerticalOptions="Start">
                                    <BoxView Color="{StaticResource Tertiary}" />
                                </Border>
                                <Label
                                    Margin="0"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource PostTextFormat}"
                                    Text="{Binding PostText}"
                                    VerticalOptions="Start" />
                            </VerticalStackLayout>


                        </Grid>

                        <!--  Post Image  -->
                        <Frame
                            Grid.Row="1"
                            Padding="0"
                            BackgroundColor="White"
                            BorderColor="{StaticResource Tertiary}"
                            CornerRadius="0"
                            IsClippedToBounds="True">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="320"
                                Source="{Binding PostImage}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.ShowImageCommand, Source={x:Reference PageRoot}}" CommandParameter="{Binding .}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Frame>

                        <!--  Like & Delete  -->
                        <HorizontalStackLayout
                            Grid.Row="2"
                            HorizontalOptions="Fill"
                            Spacing="0"
                            VerticalOptions="Center">
                            <Button
                                Margin="0"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Command="{Binding BindingContext.LikeCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}"
                                FontSize="30"
                                Style="{StaticResource BaseButtonStyle}"
                                Text="{Binding LikeIcon}"
                                WidthRequest="40" />
                            <Label
                                Padding="0"
                                HorizontalOptions="Start"
                                Style="{StaticResource LabelFormat}"
                                Text="{Binding LikeCount}"
                                VerticalOptions="Center" />
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                Command="{Binding BindingContext.DeletePostCommand, Source={x:Reference PageRoot}}"
                                CommandParameter="{Binding .}"
                                FontSize="25"
                                HorizontalOptions="End"
                                Style="{StaticResource BaseButtonStyle}"
                                Text="🗑"
                                WidthRequest="40" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>

