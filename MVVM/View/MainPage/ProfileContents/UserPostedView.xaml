<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Linux_Mint.MVVM.View.MainPage.ProfileContents.UserPostedView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="UserPostedView">
    <CollectionView
     BackgroundColor="Transparent"
     ItemsSource="{Binding Posts}"
     VerticalOptions="Fill">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="20" Style="{StaticResource Post}">
                    <Grid RowSpacing="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  User Info  -->
                        <Grid Grid.Row="0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Frame
                             Grid.Column="0"
                             Padding="0"
                             BackgroundColor="White"
                             BorderColor="Transparent"
                             CornerRadius="50"
                             HeightRequest="50"
                             IsClippedToBounds="True"
                             VerticalOptions="Center"
                             WidthRequest="50">
                                <Image
                                 Aspect="AspectFill"
                                 HeightRequest="50"
                                 HorizontalOptions="Fill"
                                 Source="{Binding UserAvatar}"
                                 VerticalOptions="Fill"
                                 WidthRequest="50" />
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Style="{StaticResource LabelFormat}" Text="{Binding FullName}" />
                                <Label
                                 FontSize="18"
                                 Text="{Binding PostCreated, StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                 TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button
                             Grid.Column="2"
                             BackgroundColor="Transparent"
                             Command="{Binding BindingContext.EditPostCommand, Source={x:Reference PageRoot}}"
                             CommandParameter="{Binding .}"
                             Style="{StaticResource BaseButtonStyle}"
                             Text="&#xe805;" />
                        </Grid>

                        <!--  Post Image  -->
                        <Frame
                         Grid.Row="1"
                         Padding="0"
                         BackgroundColor="White"
                         BorderColor="Transparent"
                         CornerRadius="10"
                         IsClippedToBounds="True">
                            <Image
                             Aspect="AspectFill"
                             HeightRequest="320"
                             Source="{Binding PostImage}"
                             WidthRequest="320" />
                        </Frame>

                        <!--  Like & Delete  -->
                        <HorizontalStackLayout
                         Grid.Row="2"
                         Spacing="10"
                         VerticalOptions="Center">
                            <Button
                             BackgroundColor="Transparent"
                             Command="{Binding BindingContext.LikeCommand, Source={x:Reference PageRoot}}"
                             CommandParameter="{Binding .}"
                             FontSize="30"
                             Style="{StaticResource BaseButtonStyle}"
                             Text="&#xe800;" />
                            <Label Style="{StaticResource LabelFormat}" Text="{Binding LikeCount}" />
                            <Button
                             BackgroundColor="Transparent"
                             Command="{Binding BindingContext.DeletePostCommand, Source={x:Reference PageRoot}}"
                             CommandParameter="{Binding .}"
                             FontSize="25"
                             Style="{StaticResource BaseButtonStyle}"
                             Text="🗑" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>