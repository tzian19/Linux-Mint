<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Linux_Mint.MVVM.View.MainPage.FlyoutContentUserProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Linux_Mint.MVVM.View.MainPage"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="PageRoot"
    Title="Profile"
    BackgroundColor="{StaticResource Primary}">

    <ContentPage.Resources>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="Fontello" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
            <Setter Property="TextColor" Value="{StaticResource Tertiary}" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="5,5" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelFormat" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource Quadra}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="#217D41" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="ToolbarItem_Clicked" IconImageSource="addpost_icon.png" />
    </ContentPage.ToolbarItems>


    <ScrollView>
        <VerticalStackLayout
            Margin="10,0,10,0"
            Spacing="10"
            VerticalOptions="Fill">
            <Border
                Margin="0"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                Stroke="{StaticResource Tertiary}"
                StrokeShape="RoundRectangle, 30"
                StrokeThickness="5"
                VerticalOptions="Center">
                <Grid
                    Margin="0"
                    Padding="20"
                    RowSpacing="10"
                    VerticalOptions="Fill">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Margin="0"
                        Padding="5"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Stroke="{StaticResource Tertiary}"
                        StrokeShape="RoundRectangle, 180"
                        StrokeThickness="5"
                        VerticalOptions="End">
                        <Frame
                            BackgroundColor="White"
                            BorderColor="{StaticResource Tertiary}"
                            CornerRadius="108"
                            HeightRequest="216"
                            HorizontalOptions="Center"
                            IsClippedToBounds="True"
                            VerticalOptions="Center"
                            WidthRequest="216">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="216"
                                HorizontalOptions="Center"
                                Source="{Binding LoggedInUser.UserAvatar, FallbackValue='default_avatar.png'}"
                                VerticalOptions="Center"
                                WidthRequest="216">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.ShowImageCommand, Source={x:Reference PageRoot}}" CommandParameter="{Binding LoggedInUser}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Frame>
                    </Border>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Margin="0"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="End">
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource SecondaryDarkText}"
                            Command="{Binding ChangePhotoCommand}"
                            FontFamily="NotoSansExtraBold"
                            FontSize="20"
                            Style="{StaticResource LabelFormat}"
                            Text="Change Photo"
                            VerticalOptions="Center" />
                        <Label
                            FontFamily="OpenSansSemibold"
                            Style="{StaticResource LabelFormat}"
                            Text="{Binding LoggedInUser.FullName}"
                            TextColor="{StaticResource SecondaryDarkText}" />
                        <Label
                            Margin="0,0,0,20"
                            FontAttributes="None"
                            FontFamily="NotoSansExtraBold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Style="{StaticResource LabelFormat}"
                            Text="{Binding LoggedInUser.Username, StringFormat='@{0}'}"
                            TextColor="{StaticResource SecondaryDarkText}"
                            VerticalOptions="Center" />
                        <!--<Button {Revisit Changes Later}
                        CornerRadius="25"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Style="{StaticResource BaseButtonStyle}"
                        Text="Edit Profile"
                        VerticalOptions="Center"
                        WidthRequest="174" />-->
                    </VerticalStackLayout>
                    <HorizontalStackLayout
                        Grid.Row="2"
                        Padding="0"
                        HorizontalOptions="Center"
                        Spacing="5"
                        VerticalOptions="Center">
                        <Button
                            Command="{Binding SwitchViewPage}"
                            CommandParameter="UserPostedView"
                            CornerRadius="25"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Style="{StaticResource BaseButtonStyle}"
                            Text="Timeline Posts"
                            VerticalOptions="Center"
                            WidthRequest="174" />
                        <Button
                            Command="{Binding SwitchViewPage}"
                            CommandParameter="AboutContentView"
                            CornerRadius="25"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Style="{StaticResource BaseButtonStyle}"
                            Text="About"
                            VerticalOptions="Center"
                            WidthRequest="174" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
            <Border
                BackgroundColor="{StaticResource Tertiary}"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 20"
                VerticalOptions="Fill">

                <ContentView
                    x:Name="ContentContainer"
                    Padding="5"
                    x:FieldModifier="public"
                    Loaded="ContentContainer_Loaded" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>