<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  
   x:Class="Linux_Mint.MVVM.View.MainPage.FlyoutContentUserProfileView"  
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
    xmlns:pages="clr-namespace:Linux_Mint.MVVM.View.MainPage"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
   Title="Profile"
    BackgroundColor="{StaticResource Primary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
        IconImageSource="addpost_icon.svg" 
        Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="10,2,10,10">
           
            <Border
                
                Grid.Row="0"
                 Stroke="Black"
                 StrokeThickness="2"
                 BackgroundColor="Transparent"
                 Padding="5"
                 HorizontalOptions="Center"
                 VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image WidthRequest="320" HeightRequest="250"/>
            </Border>
            <VerticalStackLayout VerticalOptions="Fill" HorizontalOptions="Center" Spacing="10">
                <Border
                    Margin="0,10,0,0"
                    Grid.Row="0"
                     Stroke="Black"
                     BackgroundColor="#217d41"
                     Padding="30"
                     HorizontalOptions="Center"
                     VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100"/>
                    </Border.StrokeShape>
                    <Image WidthRequest="30" HeightRequest="30"/>
                </Border>
                
                <Label Text="Username" FontSize="20" TextColor="Black" HorizontalTextAlignment="Center"/>
                <Label Text="Description" FontSize="12" TextColor="Black" HorizontalTextAlignment="Center"/>

                <Button Text="Edit Profile" TextColor="Black" FontSize="12" CornerRadius="30" Padding="0,0,0,0" />

                <HorizontalStackLayout HorizontalOptions="Fill" Spacing="100">
                    <Button Text="Timeline Photos" CornerRadius="30"/>
                    <Button Text="About" CornerRadius="30"/>
                </HorizontalStackLayout>


            </VerticalStackLayout>
           
        </Grid>
        
        
    </Grid>


</ContentPage>