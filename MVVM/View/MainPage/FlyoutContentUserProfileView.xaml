<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  
   x:Class="Linux_Mint.MVVM.View.MainPage.FlyoutContentUserProfileView"  
   xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
    xmlns:pages="clr-namespace:Linux_Mint.MVVM.View.MainPage"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
   Title="Profile"
    BackgroundColor="{StaticResource Primary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
        IconImageSource="addpost_icon.svg" 
        Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,10,0,0">

            <Border
                     Grid.Row="0"
                     Stroke="#46B47F"
                     StrokeThickness="5"
                     BackgroundColor="Transparent"
                     Padding="5"
                     HorizontalOptions="Center"
                     VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Image WidthRequest="320" HeightRequest="300"/>
            </Border>
            <VerticalStackLayout VerticalOptions="Fill" HorizontalOptions="Center" Spacing="10">
                <Border
                        Margin="0,30,0,0"
                        Grid.Row="0"
                         Stroke="Black"
                         BackgroundColor="#217d41"
                         Padding="30"
                         HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100"/>
                    </Border.StrokeShape>
                    <Image WidthRequest="30" HeightRequest="30"/>
                </Border>

                <Label Text="Username" FontSize="20" TextColor="Black" HorizontalTextAlignment="Center"/>
                <Label Text="Description" FontSize="12" TextColor="Black" HorizontalTextAlignment="Center"/>

                <Button Text="Edit Profile" TextColor="Black" BackgroundColor="#BAD9C3" WidthRequest="100" FontSize="12" CornerRadius="30" Padding="0,5,0,5" />

                <HorizontalStackLayout HorizontalOptions="Fill" Spacing="20" Margin="0,50,0,0">
                    <Button Text="Timeline Posts" BackgroundColor="#BAD9C3" CornerRadius="30" FontSize="12" WidthRequest="130"  Padding="0,5,0,5" Clicked="TimelineButton"/>
                    <Button Text="About" FontSize="12" BackgroundColor="#BAD9C3" CornerRadius="30" WidthRequest="130"  Padding="0,5,0,5" Clicked="AboutButton"/>
                </HorizontalStackLayout>


            </VerticalStackLayout>

        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,0" >
            <ScrollView BackgroundColor="Transparent" Margin="0,-10,0,10">

                <BoxView x:Name="TimelineContainer" Margin="0,0,0,0" BackgroundColor="#46B47F" HeightRequest="500" CornerRadius="10" IsVisible="True"/>
            </ScrollView>
            <Border x:Name="AboutContainer" Margin="0,-15,0,0" BackgroundColor="Green" HeightRequest="365" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <Grid Margin="10">
                    <StackLayout>
                        <Label Text="Lastname"/>   
                        <Label Text="Firstname"/>   
                        <Label Text="Email"/>
                        <Label Text="Birthdate"/>
                        <Label Text="Age"/>
                    </StackLayout>
                </Grid>

            </Border>


        </Grid>


    </Grid>



</ContentPage>