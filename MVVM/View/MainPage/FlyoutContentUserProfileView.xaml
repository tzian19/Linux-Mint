<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Linux_Mint.MVVM.View.MainPage.FlyoutContentUserProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Linux_Mint.MVVM.View.MainPage"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    Title="Profile"
    BackgroundColor="{StaticResource Primary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="ToolbarItem_Clicked" IconImageSource="addpost_icon.svg" />
    </ContentPage.ToolbarItems>

    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="10,2,10,10"
            HorizontalOptions="Fill">

            <Border
                Padding="5"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                Stroke="Black"
                StrokeThickness="2"
                VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Image HeightRequest="250" WidthRequest="320" />
            </Border>
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="10"
                VerticalOptions="Fill">
                <Border
                    Grid.Row="0"
                    Margin="0,10,0,0"
                    Padding="30"
                    BackgroundColor="#217d41"
                    HorizontalOptions="Center"
                    Stroke="Black"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <Image HeightRequest="30" WidthRequest="30" />
                </Border>

                <Label
                    FontSize="20"
                    HorizontalTextAlignment="Center"
                    Text="Username"
                    TextColor="Black" />
                <Label
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Text="Description"
                    TextColor="Black" />

                <Button
                    Padding="0,0,0,0"
                    CornerRadius="30"
                    FontSize="12"
                    Text="Edit Profile"
                    TextColor="Black" />

                <HorizontalStackLayout HorizontalOptions="Fill" Spacing="100">
                    <Button CornerRadius="30" Text="Timeline Photos" />
                    <Button CornerRadius="30" Text="About" />
                </HorizontalStackLayout>


            </VerticalStackLayout>

        </Grid>


    </Grid>


</ContentPage>