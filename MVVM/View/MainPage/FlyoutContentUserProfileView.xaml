<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Linux_Mint.MVVM.View.MainPage.FlyoutContentUserProfileView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Linux_Mint.MVVM.View.MainPage"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    Title="Profile"
    BackgroundColor="{StaticResource Primary}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="ToolbarItem_Clicked" IconImageSource="addpost_icon.svg" />
    </ContentPage.ToolbarItems>
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Profile Header  -->
        <VerticalStackLayout
                     Grid.Row="0"
            Margin="0,10"
            HorizontalOptions="Center"
            Spacing="10">
            <Border
                     Padding="5"
                BackgroundColor="Transparent"
                     HorizontalOptions="Center"
                Stroke="#46B47F"
                StrokeThickness="5"
                     VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Image
                    Aspect="AspectFill"
                    HeightRequest="300"
                    Source="{Binding BannerImage}"
                    WidthRequest="320" />
            </Border>

                <Border
                        Grid.Row="0"
                    Margin="0,30,0,0"
                         Padding="30"
                    BackgroundColor="#217d41"
                    HorizontalOptions="Center"
                    Stroke="Black">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <Image HeightRequest="30" WidthRequest="30" />

                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="80"
                        Source="{Binding UserAvatar}"
                        WidthRequest="80" />
                    <Label
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Username}"
                        TextColor="Black" />
                    <Label
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Description}"
                        TextColor="Black" />

                    <Button
                        BackgroundColor="#BAD9C3"
                        CornerRadius="30"
                        FontSize="12"
                        Text="Edit Profile"
                        TextColor="Black"
                        WidthRequest="100" />

                    <HorizontalStackLayout
                        Margin="0,20,0,0"
                        HorizontalOptions="Center"
                        Spacing="20">
                        <Button
                            BackgroundColor="#BAD9C3"
                            Clicked="TimelineButton"
                            CornerRadius="30"
                            FontSize="12"
                            Text="Timeline Posts"
                            WidthRequest="130" />
                        <Button
                            BackgroundColor="#BAD9C3"
                            Clicked="AboutButton"
                            CornerRadius="30"
                            FontSize="12"
                            Text="About"
                            WidthRequest="130" />
                </HorizontalStackLayout>


            </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!--  Main Content  -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <!--  Timeline View  -->
            <ScrollView
                x:Name="TimelineContainer"
                Margin="0,0,0,10"
                IsVisible="True">
                <BoxView
                    BackgroundColor="#46B47F"
                    CornerRadius="10"
                    HeightRequest="500" />
            </ScrollView>

            <!--  About Section  -->
            <Border
                x:Name="AboutContainer"
                Margin="0,0,0,10"
                BackgroundColor="Green"
                HeightRequest="365"
                IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <StackLayout Margin="10">
                    <Label Text="{Binding LastName}" />
                    <Label Text="{Binding FirstName}" />
                    <Label Text="{Binding Email}" />
                    <Label Text="{Binding BirthDate}" />
                    <Label Text="{Binding Age}" />
                    </StackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>


</ContentPage>